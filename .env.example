# Local use. For another device, set PUBLIC_URL to the address both devices use.
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=http://localhost:3000
DATA_DIR=./data

# Optional. Set a unique password with at least 12 characters before first startup.
# With this variable unset, the server prints a random password on first startup.
# This variable does not change an existing account password.
# CHAT_PASSWORD=

# Docker Compose publishes to loopback unless this value changes.
BIND_ADDRESS=127.0.0.1

# Optional dedicated rootless runner broker. Never use a Docker/Podman engine socket.
# CHAT_RUNNER_SOCKET=/run/common-chat-runner/control.sock

# Release policy only. This does not install updates or restart the application.
# The primary installation receives preview builds before stable promotion.
CHAT_UPDATE_CHANNEL=preview
